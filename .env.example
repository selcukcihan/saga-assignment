DATABASE_URL=postgres://saga:saga@postgres:5432/saga
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
PDF_OCR_ENABLED=true
PDF_OCR_MIN_NATIVE_CHARACTERS=100
PDF_OCR_DPI=200
PDF_OCR_LANGUAGE=eng
PDF_OCR_TIMEOUT_MS=60000

# Compose uses this key for both providers unless either provider-specific key below is set.
OPENAI_API_KEY=replace-with-your-key

# Use an OpenAI key, or a non-empty placeholder when pointing at a local compatible server.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000

GENERATION_API_KEY=
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_MODEL=gpt-5.4-mini
GENERATION_TIMEOUT_MS=60000

CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_LIMIT=5
CHAT_HISTORY_LIMIT=10

WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
