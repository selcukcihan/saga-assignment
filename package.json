{
  "name": "saga-knowledge-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start:api": "node --enable-source-maps dist/api/main.js",
    "start:worker": "node --enable-source-maps dist/worker/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --enable-source-maps dist/infrastructure/db/migrate.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "mammoth": "1.12.1",
    "multer": "2.2.0",
    "openai": "7.5.0",
    "pdfjs-dist": "6.2.108",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
